root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Golden contract snapshots are byte-compared by ToolManifestContractUnitTest /
# ResultShapeContractUnitTest. Tool descriptions with blank lines serialize as
# indent-only lines, so trimming them silently breaks the tests.
[src/test/resources/contract/**]
trim_trailing_whitespace = false
