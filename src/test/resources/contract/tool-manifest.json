        "type": "string"
      },
      "rearrangeCode":
      {
        "description": "Rearrange code members according to arrangement rules. Default: true.",
        "type": "boolean"
      },
      "startLine":
      {
        "description": "Start line for partial formatting (1-based). If provided, endLine is also required.",
        "type": "integer"
      }
